{
  "id": "soksak-plugin-terminal-ghostty",
  "name": { "en": "Ghostty Terminal", "ko": "Ghostty 터미널" }, "version": "0.0.17",
  "appVersionRequirement": "0.0.1",
  "description": { "en": "Terminal view rendered from the ghostty provider frame.", "ko": "Ghostty 공급자 프레임을 렌더링하는 터미널 뷰입니다." },
  "entry": "main.js", "permissions": ["ui", "ui:statusbar", "commands", "programs", "sidecar", "secrets", "terminal"],
  "implements": [{ "id": "soksak-spec-plugin-terminal", "version": "0.0.8" }],
  "contributes": {
    "commands": [
      { "name": "status", "title": { "en": "Terminal status", "ko": "터미널 상태" } },
      { "name": "wait", "title": { "en": "Wait for terminal phase", "ko": "터미널 단계 대기" } },
      { "name": "archive", "title": { "en": "Archive terminal state", "ko": "터미널 상태 보관" } },
      { "name": "send", "title": { "en": "Send input", "ko": "입력 보내기" }, "danger": "inject" },
      { "name": "read", "title": { "en": "Read screen", "ko": "화면 읽기" } },
      { "name": "clear", "title": { "en": "Clear terminal", "ko": "터미널 지우기" } },
      { "name": "focus", "title": { "en": "Focus terminal", "ko": "터미널 포커스" } },
      { "name": "recovery-status", "title": { "en": "Recovery status", "ko": "복원 상태" } },
      { "name": "split", "title": { "en": "Split the terminal", "ko": "터미널 분할" } },
      { "name": "pane.close", "title": { "en": "Close a pane", "ko": "pane 닫기" } },
      { "name": "pane.focus", "title": { "en": "Focus a pane", "ko": "pane 포커스" } },
      { "name": "pane.list", "title": { "en": "List panes", "ko": "pane 목록" } },
      { "name": "pane.resize", "title": { "en": "Resize a pane", "ko": "pane 크기 조절" } },
      { "name": "pane.equalize", "title": { "en": "Equalize the panes", "ko": "pane 균등화" } },
      { "name": "pane.maximize", "title": { "en": "Maximize a pane", "ko": "pane 최대화" } },
      { "name": "pane.broadcast", "title": { "en": "Broadcast input to every pane", "ko": "모든 pane에 입력 전달" } },
      { "name": "pane.title", "title": { "en": "Set a pane title", "ko": "pane 제목 설정" } },
      { "name": "scroll", "title": { "en": "Scroll the screen", "ko": "화면 스크롤" } },
      { "name": "selection", "title": { "en": "Read or copy the selection", "ko": "선택 읽기·복사" } },
      { "name": "input.compose", "title": { "en": "Compose input text", "ko": "입력 텍스트 조합" }, "danger": "inject" }
    ],
    "nodes": [{ "id": "terminal-root" }, { "id": "terminal-screen" }, { "id": "terminal-input" }, { "id": "terminal-restore-status" }],
    "programs": [{ "id": "terminal-ghostty", "title": { "en": "Ghostty Terminal", "ko": "Ghostty 터미널" }, "kind": "view", "view": "content" }],
    "views": [{ "id": "content", "title": { "en": "Ghostty Terminal", "ko": "Ghostty 터미널" }, "icon": "VT", "surfaces": ["tab"], "status": ["connecting", "error"] }]
  },
  "runtimeDependencies": {
    "sidecars": [
      { "id": "soksak-sidecar-pty", "version": "0.0.8" },
      { "id": "soksak-sidecar-terminal-ghostty", "version": "0.0.14" }
    ]
  }
}
